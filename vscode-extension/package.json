{
  "name": "tspp-development",
  "displayName": "TS++ Development",
  "description": "Development host support for the TS++ compiler in this repository.",
  "version": "0.0.1",
  "publisher": "tspp-local",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "tspp.kind-operators",
        "path": "./syntaxes/tspp-kind-operators.tmLanguage.json",
        "injectTo": ["source.ts"]
      },
      {
        "scopeName": "tspp.nominal-declarations",
        "path": "./syntaxes/tspp-nominal-declarations.tmLanguage.json",
        "injectTo": ["source.ts"]
      },
      {
        "scopeName": "tspp.macros",
        "path": "./syntaxes/tspp-macros.tmLanguage.json",
        "injectTo": ["source.ts"]
      },
      {
        "scopeName": "tspp.formal-contracts",
        "path": "./syntaxes/tspp-formal-contracts.tmLanguage.json",
        "injectTo": ["source.ts"]
      }
    ],
    "commands": [
      {
        "command": "tspp.pickExample",
        "title": "TS++: Choose Example"
      },
      {
        "command": "tspp.openAllExamples",
        "title": "TS++: Open All Examples"
      },
      {
        "command": "tspp.openHigherKindedTypesExample",
        "title": "TS++: Open Higher-Kinded Types Example"
      },
      {
        "command": "tspp.openDependentTypesExample",
        "title": "TS++: Open Dependent Types Example"
      },
      {
        "command": "tspp.openNewtypeAndDataExample",
        "title": "TS++: Open Newtype and Data Example"
      },
      {
        "command": "tspp.openMacrosExample",
        "title": "TS++: Open Compile-Time Macros Example"
      },
      {
        "command": "tspp.openFormalContractsExample",
        "title": "TS++: Open Formal Contracts Example"
      },
      {
        "command": "tspp.showExpandedSource",
        "title": "TS++: Show Expanded Source",
        "icon": "$(preview)"
      },
      {
        "command": "tspp.showVerificationSmt",
        "title": "TS++: Show Verification SMT-LIB",
        "icon": "$(symbol-operator)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tspp.showExpandedSource",
          "when": "editorLangId == typescript && resourceExtname == .tspp",
          "group": "navigation@10"
        },
        {
          "command": "tspp.showVerificationSmt",
          "when": "editorLangId == typescript && resourceExtname == .tspp",
          "group": "navigation@11"
        }
      ]
    }
  }
}
