{
  "name": "TypeScript++ Kind Operators",
  "scopeName": "tspp.kind-operators",
  "injectionSelector": "L:meta.type.declaration.ts -meta.type.parameters.ts -meta.type.function.return.ts -comment -string",
  "patterns": [
    {
      "name": "storage.type.function.arrow.ts",
      "match": "=>(?=[^=;\\r\\n]*=(?!=|>))"
    }
  ]
}
