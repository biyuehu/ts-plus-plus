{
  "name": "TS++ Compile-time Macros",
  "scopeName": "tspp.macros",
  "injectionSelector": "L:source.tspp -comment -string, L:source.ts -comment -string",
  "patterns": [
    {
      "match": "^(\\s*)(?:(export)(\\s+))?(?:(default)(\\s+))?(?:(declare)(\\s+))?(?:(async)(\\s+))?(macro)(\\s+)(?=function\\b)",
      "captures": {
        "2": { "name": "keyword.control.export.ts" },
        "4": { "name": "storage.modifier.ts" },
        "6": { "name": "storage.modifier.ts" },
        "8": { "name": "storage.modifier.async.ts" },
        "10": { "name": "keyword.control.macro.tspp" }
      }
    },
    {
      "match": "^\\s*(macro)(?=\\s+[A-Za-z_$][\\w$]*(?:\\s*\\.\\s*[A-Za-z_$][\\w$]*)*\\s*\\()",
      "captures": {
        "1": { "name": "keyword.control.macro.tspp" }
      }
    },
    {
      "name": "meta.function.with-signature.tspp",
      "begin": "\\b(with)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.with.tspp" }
      },
      "end": "(?<=\\})(?!\\s*(?::|\\{))|(?=;)",
      "patterns": [
        {
          "name": "meta.function.with-clause.tspp",
          "begin": "\\G(\\s*)(\\{)",
          "beginCaptures": {
            "2": { "name": "punctuation.definition.block.begin.tspp" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.tspp" }
          },
          "patterns": [
            { "include": "#with-clause-body" }
          ]
        },
        { "include": "source.ts#type-annotation" },
        { "include": "source.ts#decl-block" },
        { "include": "source.ts#comment" }
      ]
    }
  ],
  "repository": {
    "with-clause-body": {
      "patterns": [
        { "include": "source.ts#comment" },
        { "include": "source.ts#string" },
        { "include": "source.ts#literal" },
        {
          "match": "([A-Za-z_$][\\w$]*)(\\s*)(:)",
          "captures": {
            "1": { "name": "variable.other.property.ts" },
            "3": { "name": "punctuation.separator.key-value.ts" }
          }
        },
        {
          "name": "meta.object-literal.ts",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.block.begin.ts" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.ts" }
          },
          "patterns": [
            { "include": "#with-clause-body" }
          ]
        },
        { "include": "$base" }
      ]
    }
  }
}
