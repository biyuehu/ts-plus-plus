// 本示例演示 TS++ 的类型层 lambda（type lambda），即 <T> => Body 语法。
// 需要在 tsppconfig.json 中开启：typeComputation（核心）、higherKindedTypes 和 typeUniverses（用于第 3、4 节）。

// ─────────────────────────────────────────────────────────────────
// 1. 基础：恒等与投影
// ─────────────────────────────────────────────────────────────────

// 最简单的类型 lambda：原样返回其类型参数。
type Id = <T> => T;

// 可以像普通类型构造器一样用尖括号应用。
type IdNumber = Id<number>;  // number
type IdString = Id<string>;  // string

// 二元 lambda：只取第一个参数，丢弃第二个。
type Fst = <A, B> => A;
type FstResult = Fst<boolean, string>;  // boolean

// 二元 lambda：交换二元组的两个分量。
type Swap = <A, B> => [B, A];
type SwapResult = Swap<string, number>;  // [number, string]

// ─────────────────────────────────────────────────────────────────
// 2. 柯里化：类型层 lambda 可以嵌套
// ─────────────────────────────────────────────────────────────────

// 外层 lambda 捕获 A，内层 lambda 接受 B，组合为元组。
// CurriedPair<A> 的 kind 是 Type => Type，可以进一步应用。
type CurriedPair = <A> => (<B> => [A, B]);

type PairWithString = CurriedPair<string>;        // <B> => [string, B]
type StringAndNumber = PairWithString<number>;    // [string, number]

// ─────────────────────────────────────────────────────────────────
// 3. 与高阶类型参数结合（需要 higherKindedTypes）
// ─────────────────────────────────────────────────────────────────

// Apply 接受任意 kind 为 Type => Type 的类型构造器 F 和参数 X。
type Apply<F: Type => Type, X> = F<X>;

// 把 Id lambda 传给 Apply：结果仍然是 X。
type Applied1 = Apply<<T> => T, boolean>;  // boolean

// 把 "装箱" lambda 传给 Apply：把 boolean 装入数组。
type Applied2 = Apply<<T> => T[], boolean>;  // boolean[]

// 把 "配对" lambda 传给 Apply：把 number 与自身配对。
type Applied3 = Apply<<T> => [T, T], number>;  // [number, number]

// ─────────────────────────────────────────────────────────────────
// 4. 高阶组合子
// ─────────────────────────────────────────────────────────────────

// 类型层函数组合：先应用 G，再应用 F。
type Compose<F: Type => Type, G: Type => Type> = <X> => F<G<X>>;

// 先 Array 再 Array：双层数组。
type Twice = Compose<Array, Array>;
type TwiceResult = Twice<string>;  // string[][]

// 先 Array 再 ReadonlyArray：只读外层，可变内层。
type ROArray = Compose<ReadonlyArray, Array>;
type ROArrayResult = ROArray<number>;  // readonly number[][]

// ─────────────────────────────────────────────────────────────────
// 5. 类型层别名与 let 风格复用
// ─────────────────────────────────────────────────────────────────

// 用普通 type alias 给 lambda 命名以便复用。
type Box = <T> => { readonly value: T };

type BoxedString = Box<string>;   // { readonly value: string }
type BoxedNumber = Box<number>;   // { readonly value: number }

// 组合具名 lambda：先装箱，再包数组。
type BoxedArray = Compose<Array, Box>;
type BoxedArrayResult = BoxedArray<boolean>;  // Array<{ readonly value: boolean }>

// ─────────────────────────────────────────────────────────────────
// 6. 错误示例（由 @ts-expect-error 保护的反例）
// ─────────────────────────────────────────────────────────────────

// @ts-expect-error -- 参数数量不匹配：Swap 需要两个参数，这里只给了一个
type BadSwap = Swap<string>;

// @ts-expect-error -- kind 不兼容：string 的 kind 是 Type，不是 Type => Type
type BadApply = Apply<string, number>;

export type {
    Apply,
    Applied1,
    Applied2,
    Applied3,
    BadApply,
    BadSwap,
    Box,
    BoxedArray,
    BoxedArrayResult,
    BoxedNumber,
    BoxedString,
    Compose,
    CurriedPair,
    Fst,
    FstResult,
    Id,
    IdNumber,
    IdString,
    PairWithString,
    ROArray,
    ROArrayResult,
    Swap,
    SwapResult,
    StringAndNumber,
    Twice,
    TwiceResult,
};

