// 本示例演示 TS++ 的两个名义化声明：newtype 与 data。
// 两者都通过编译器内部的 brand 属性获得名义性，但用途不同。

// -----------------------------------------------------------------------------
// 1. newtype：给已有类型一个不可互换的新名字
// -----------------------------------------------------------------------------
//
// newtype 接受任意类型作为底层。用户 ID 和订单 ID 都是 number，
// 但它们是不同的名义类型，不能互相赋值。

newtype UserId = number;
newtype OrderId = number;

declare const userId: UserId;
declare const orderId: OrderId;

// UserId 可以赋给 number，因为底层就是 number。
const asNumber: number = userId;

// 反过来不行：number 不能赋给 UserId。
// @ts-expect-error -- number 不是 UserId
const badNumber: UserId = 1;

// UserId 与 OrderId 也不能互相赋值。
// @ts-expect-error -- 不同 newtype 之间保持名义隔离
const badOrder: OrderId = userId;

// newtype 会引入一个同名的值构造器，签名是底层类型的恒等函数。
const created: UserId = UserId(42);
const createdOrder: OrderId = OrderId(created + 0);

// 底层可以是对象、联合等任意类型。
newtype Point = { x: number; y: number };
newtype StringOrNumber = string | number;

// -----------------------------------------------------------------------------
// 2. data：可辨识联合与变体构造器
// -----------------------------------------------------------------------------
//
// data 声明一组变体，每个变体可以携带字段。所有变体通过 _tag 区分，
// 整体形成一个联合类型。

data Option<T> = None | Some(value: T);

// None 是一个常量；Some 是一个构造器。
const nothing: Option<number> = None;
const something: Option<number> = Some(1);

// 字段类型会被检查。
// @ts-expect-error -- Some 的字段应为 number
const bad: Option<number> = Some("x");

// 变体只接收它提到的类型参数：None 不接受参数，Some 只接受 T。
data Either<L, R> = Left(value: L) | Right(value: R) | Empty;

const leftArm: Either<number, string> = Left(1);
const rightArm: Either<number, string> = Right("x");
const emptyArm: Either<number, string> = Empty;

// data 类型可以递归。
data List<T> = Nil | Cons(head: T, tail: List<T>);

const emptyList: List<number> = Nil;
const singleItem: List<number> = Cons(1, Nil);

// value-level match 会检查构造器是否穷尽，并把字段绑定到分支局部变量。
declare const maybe: Option<number>;
const selected: number = match maybe {
  None => 0,
  Some(value) => value,
};

// 无字段变体可以通过 | 共用分支；带字段的变体可以继续嵌套匹配。
// guard 只处理满足条件的值，后续分支仍负责剩余情况。
data Outcome = Success(value: number) | Failure(code: number);
data ScreenState = Idle | Loading | Finished(outcome: Outcome);

declare const screen: ScreenState;
const score: number = match screen {
  Idle | Loading => 0,
  Finished(Success(value)) if value > 0 => value,
  Finished(Success(_)) => 0,
  Finished(Failure(code)) => -code,
};

// 每个变体是值，不能直接作为独立类型使用，得通过 typeof。
const extracted: typeof Nil = Nil;
const tag: "Nil" = extracted._tag;

// 尽管与结构化的 { _tag: "Nil" } 相像，但实际上不能作为使用
// @ts-expect-error -- 结构相似的对象没有 Nil 的名义 brand
const error: typeof Nil = { _tag: "Nil" as const };

// -----------------------------------------------------------------------------
// 3. 名义性与 as
// -----------------------------------------------------------------------------
//
// 名义类型阻止无意的结构赋值。显式 as 仍然可以覆盖，
// 因为它不执行结构兼容检查。

// const stolen: UserId = 1 as UserId;

// 品牌属性不会出现在 keyof、诊断消息或 hover 中。
const keys: "x" | "y" = "x" satisfies keyof Point;

export { asNumber, created, createdOrder, emptyArm, emptyList, extracted, keys, leftArm, nothing, rightArm, score, selected, singleItem, something, tag };
export type { Either, List, Option, OrderId, Outcome, Point, ScreenState, Some, StringOrNumber, UserId };


// -----------------------------------------------------------------------------
// 4. 与高阶类型的交互
// -----------------------------------------------------------------------------
//
// 毫无疑问，当然是天然支持作为一等传递的，data 与 newtype 的类型构造器并不是特例

type Apply<A: Type => Type, B> = A<B>

newtype Pack<A> = List<A>

type Numbers = Apply<Pack, number>

const numbers: Numbers = Pack(Nil)

data FF<F: Type => Type, A> = B | C(x: F<A>)

// const ff: FF<List, string> = C(Cons("",Nil) as List<string>)
