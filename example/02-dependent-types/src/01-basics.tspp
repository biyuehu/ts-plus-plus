// =============================================================================
// 基础篇：从 TypeScript 类型到依赖函数
// =============================================================================
//
// 本篇不要求了解类型论。请按顺序阅读，只需建立四个概念：
//
//   1. 值有类型，类型自己也有“类型”；
//   2. `->` 声明一个可被右侧引用的名字；
//   3. 类型族是“输入一个类型，输出另一个类型”的函数；
//   4. 依赖函数类型可以连接普通 TypeScript 泛型函数。

// -----------------------------------------------------------------------------
// 1. 先区分“值”、“类型”和“宇宙”
// -----------------------------------------------------------------------------
//
// 普通 TypeScript 中："hello" : string。左边是值，右边是类型。
// MLTT 继续追问：`string` 这个类型属于什么？
//
//   普通值   : 普通类型
//   普通类型 : Type0
//   Type0    : Type1
//   Type1    : Type2

export type UniverseZero: Type1 = Type0;
export type UniverseOne: Type2 = Type1;

// 在 kind 标注中，旧写法 Type 等价于 Type0。
export type LegacyKindAnnotation: Type = string;

// 宇宙分层用来避免“包含自己的类型集合”引发矛盾。
// 入门时只需记住：普通 TS 类型位于 Type0。

// -----------------------------------------------------------------------------
// 2. `=>` 和 `->` 是两种不同的箭头
// -----------------------------------------------------------------------------

// 原有 TypeScript 函数类型使用 `=>`。
export type OrdinaryStringFunction = (value: string) => string;

// TS++ 依赖函数类型（Pi 类型）使用 `->`。
export type PolymorphicIdentity: Type1 =
  {A: Type0} -> (value: A) -> A;

// 从左到右读：
//
//   1. 编译器推断一个普通类型，将它命名为 A；
//   2. 再接收一个 A 类型的值；
//   3. 结果仍然是 A。
//
// 右侧能引用左侧刚刚引入的 A，这就是“依赖”。
// binder 是被引入的名字，例如这里的 A 和 value。`{A: Type0}` 是隐式
// binder，`(value: A)` 是显式 binder；隐式参数使用 `{}`，显式参数使用 `()`。
// `->` 从右向左结合，因此上面等价于：
//
//   {A: Type0} -> ((value: A) -> A)

// 右侧不引用 binder 时，它退化成非依赖形式。
export type ConstantTypeFunction: Type1 =
  (A: Type0) -> (B: Type0) -> A;

// -----------------------------------------------------------------------------
// 3. 类型族与类型应用
// -----------------------------------------------------------------------------
//
// 类型族可以理解为类型层的函数。
// `(A: Type0) -> Type0` 接收一个普通类型，并产生一个普通类型。
export type TypeFamilyShape: Type1 =
  (A: Type0) -> Type0;

// F<A> 是类型应用：把类型 A 交给类型族 F。
export type ApplyTypeFamily: Type1 =
  (F: (A: Type0) -> Type0) ->
  (A: Type0) ->
  F<A>;

export type ApplyFamilyToString: Type1 =
  (F: (A: Type0) -> Type0) ->
  F<string>;

// -----------------------------------------------------------------------------
// 4. 它如何和运行时 TypeScript 连接
// -----------------------------------------------------------------------------

// 实现仍然是普通 TypeScript，不需要新的 JavaScript 语法。
const ordinaryIdentity = <A>(value: A): A => value;

// 显式注解的 TS 泛型函数可赋给等价的 Pi 类型。
export const identity: PolymorphicIdentity = ordinaryIdentity;

// A 是编译期类型参数，运行时只传入 value。
// 不写显式类型参数时，仍使用 TypeScript 原有的推断。
export const explicitResult = identity<string>("explicit");
export const inferredResult = identity("inferred");

// 隐式 binder 可以和显式 binder 交替书写；调用边界会把所有 `{}` binder
// 收集为泛型，把所有 `()` binder 保持为实际参数。
export type SelectRight: Type1 =
  {A: Type0} -> (left: A) -> {B: Type0} -> (right: B) -> B;
export declare const selectRight: SelectRight;

// `auto` 只在调用的类型实参列表中表示“这一项继续推断”。这里固定 B=string，
// A 仍从第一个实际参数推断。
export const partiallyExplicitResult = selectRight<auto, string>(1, "right");

// -----------------------------------------------------------------------------
// 5. MLTT binder 可以包住普通 TypeScript 类型
// -----------------------------------------------------------------------------
//
// TS++ 没有抛弃 TypeScript 的类型系统。object、union、keyof、mapped type
// 仍由原来的 TS checker 解释；MLTT 只负责外层 binder、应用、归约和宇宙。

type Box<T> = { value: T };
export type BoxFamily: Type1 = (A: Type0) -> Box<A>;
export type UnionFamily: Type1 = (A: Type0) -> A | undefined;
export type KeyFamily: Type1 = (A: Type0) -> keyof A;

// binder 名只是给人看的。下面两种写法绑定关系相同，因此定义相等。
export type IdentityWithA: Type1 = (A: Type0) -> (value: A) -> A;
export type IdentityWithT: Type1 = (T: Type0) -> (item: T) -> T;

// “定义相等”不是一个需要手写证明的命题；它是 checker 判断两个表达式
// 经过改名和计算后是否为同一类型的规则。下一篇会用 Bool 的计算规则
// 给出第一个可以直接观察的例子。
