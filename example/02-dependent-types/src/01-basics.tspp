// =============================================================================
// 基础篇：universe、依赖函数和类型族
// =============================================================================
//
// 建议从上到下阅读。本篇只建立三个概念：
//
//   1. 类型本身也有层级；
//   2. `->` 引入可以被右侧引用的 binder；
//   3. 类型族是类型层面的函数。

// -----------------------------------------------------------------------------
// 1. Universe
// -----------------------------------------------------------------------------
//
//   普通值   : 某个普通类型
//   普通类型 : Type0
//   Type0    : Type1
//   Type1    : Type2

export type UniverseZero: Type1 = Type0;
export type UniverseOne: Type2 = Type1;

// 在冒号右侧的 kind 标注中，旧写法 `Type` 等价于 `Type0`。
export type LegacyKindAnnotation: Type = string;

// -----------------------------------------------------------------------------
// 2. 普通函数与依赖函数
// -----------------------------------------------------------------------------

// 普通 TypeScript 函数类型继续使用 `=>`。
export type OrdinaryStringFunction = (value: string) => string;

// TS++ 依赖函数使用 `(binder: domain) -> codomain`。
// 右侧的参数类型和结果类型都可以引用之前选择的 A。
export type PolymorphicIdentity: Type1 =
  (A: Type0) -> (value: A) -> A;

// `->` 从右向左结合：
//
//   (A: Type0) -> (value: A) -> A
//
// 等价于：
//
//   (A: Type0) -> ((value: A) -> A)

// 结果没有引用 binder 时，它仍是合法的 Pi 类型，只是退化成非依赖形式。
export type TypeFamilyShape: Type1 =
  (A: Type0) -> Type0;

// 结果依赖 A，但不依赖 B。
export type ConstantTypeFunction: Type1 =
  (A: Type0) -> (B: Type0) -> A;

// -----------------------------------------------------------------------------
// 3. 类型族应用
// -----------------------------------------------------------------------------
//
// F 接收一个普通类型并产生普通类型，`F<A>` 表示把 F 应用到 A。

export type ApplyTypeFamily: Type1 =
  (F: (A: Type0) -> Type0) ->
  (A: Type0) ->
  F<A>;

export type ApplyConstantFamily: Type1 =
  (F: (A: Type0) -> Type0) ->
  F<string>;

// 当前这些声明只描述类型，还没有对应的运行时 dependent function 实现语法。
