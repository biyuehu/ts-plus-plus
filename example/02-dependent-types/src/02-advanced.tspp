// =============================================================================
// 高级篇：索引、计算、证明和依赖对
// =============================================================================
//
// 本篇按以下顺序建立能力：
//
//   Nat 表示长度
//     ↓
//   NatAdd 在类型级计算
//     ↓
//   NatElim 描述递归原理
//     ↓
//   Eq / Refl 把“相等”表示为类型和证明
//     ↓
//   J 对相等证明做 path induction
//     ↓
//   Sigma 把数据和依赖它的证明放在一起

// -----------------------------------------------------------------------------
// 1. MLTT 可以嵌入原有 TypeScript 类型
// -----------------------------------------------------------------------------
//
// MLTT 负责 binder、universe、归约和定义相等；
// object、union、keyof、mapped type 等仍由 TypeScript checker 负责。

type Box<T> = { value: T };
export type UnionResult: Type1 = (A: Type0) -> A | string;
export type GenericResult: Type1 = (A: Type0) -> Box<A>;
export type KeysOf: Type1 = (A: Type0) -> keyof A;
export type ReadonlyShape: Type1 =
  (A: Type0) -> { readonly [K in keyof A]: A[K] };

// external TS 类型仍遵守结构类型语义。
type LeftShape = { value: string };
type RightShape = { value: string };
export type WithLeftShape: Type1 = (A: Type0) -> LeftShape;
export type WithRightShape: Type1 = (A: Type0) -> RightShape;

// binder 的拼写不影响含义；下面两个类型 alpha 等价。
export type IdentityWithA: Type1 = (A: Type0) -> (value: A) -> A;
export type IdentityWithT: Type1 = (T: Type0) -> (item: T) -> T;

// -----------------------------------------------------------------------------
// 2. Nat：把数字放进类型
// -----------------------------------------------------------------------------
//
// Nat 是自然数的类型；Zero 是 0，Succ<N> 表示 N 的后继。
//
//   Zero             = 0
//   Succ<Zero>       = 1
//   Succ<Succ<Zero>> = 2

type Vector<N extends number, A> = { length: N; value: A };

export type EmptyVector: Type1 =
  (A: Type0) -> Vector<Zero, A>;

export type TwoVector: Type1 =
  (A: Type0) -> Vector<Succ<Succ<Zero>>, A>;

// TS 调用桥接会把 (N: Nat) 投影成 N extends number，
// 并只接受非负安全整数的字面量类型，避免负数、小数或宽泛 number
// 越过 MLTT 的 Nat 边界。
export type VectorBuilder: Type1 =
  (A: Type0) ->
  (value: A) ->
  (N: Nat) ->
  Vector<N, A>;

export declare const buildVector: VectorBuilder;
export const pair = buildVector("item", 2); // Vector<2, string>
// @ts-expect-error -- -1 不是 Nat
buildVector("item", -1);
declare let dynamicLength: number;
// @ts-expect-error -- 动态 number 不能证明自己是 Nat
buildVector("item", dynamicLength);

// -----------------------------------------------------------------------------
// 3. NatAdd：受限但可预测的类型级计算
// -----------------------------------------------------------------------------
//
//   NatAdd<Zero, M>    → M
//   NatAdd<Succ<N>, M> → Succ<NatAdd<N, M>>
//
// 这种结构递归总会终止，因此定义相等、缓存和增量编译仍可预测。
export type ComputedTwoVector: Type1 =
  (A: Type0) ->
  Vector<NatAdd<Succ<Zero>, Succ<Zero>>, A>;

// -----------------------------------------------------------------------------
// 4. NatElim：把“对自然数做递归”写成规则
// -----------------------------------------------------------------------------
//
// P 是命题或结果类型，可以随 N 变化。要得到 P<N>，需要：
//
//   zeroCase      : P<Zero>
//   successorCase : 已知 P<N> 时，如何得到 P<Succ<N>>

export type NaturalNumberInduction: Type1 =
  (P: (N: Nat) -> Type0) ->
  (zeroCase: P<Zero>) ->
  (successorCase: (N: Nat) -> (previous: P<N>) -> P<Succ<N>>) ->
  (N: Nat) ->
  P<N>;

// NatElim<P, z, s, Zero> 会按计算规则归约为 z。
export type NatZeroComputation: Type1 =
  (P: (N: Nat) -> Type0) ->
  (zeroCase: P<Zero>) ->
  (successorCase: (N: Nat) -> (previous: P<N>) -> P<Succ<N>>) ->
  Eq<P<Zero>, NatElim<P, zeroCase, successorCase, Zero>, zeroCase>;

// Lam + Ann 也能构造闭合的 motive 和递归分支，因此 NatElim 不必依赖外层 Pi。
export type ClosedNatElimComputation: Type0 = Eq<
  Nat,
  NatElim<
    Ann<Lam<(value: Nat) -> Nat>, (value: Nat) -> Type0>,
    Zero,
    Ann<
      Lam<(value: Nat) -> Lam<(previous: Nat) -> Succ<previous>>>,
      (value: Nat) -> (previous: Nat) -> Nat
    >,
    Succ<Zero>
  >,
  Succ<Zero>
>;

// -----------------------------------------------------------------------------
// 5. Eq 和 Refl：命题也是类型
// -----------------------------------------------------------------------------
//
// Eq<A, left, right> 表示“A 中的 left 和 right 相等”。
// 它是一个类型；该类型的值就是这个命题的证明。
export type Reflexivity: Type1 =
  (A: Type0) ->
  (value: A) ->
  Eq<A, value, value>;

// Refl 是反身性证明：每个值都等于自己。
export type ReflexivityProof: Type1 =
  (A: Type0) ->
  (value: A) ->
  Eq<Eq<A, value, value>, Refl<A, value>, Refl<A, value>>;

// propositions-as-types 的心智模型：命题 <-> 类型，证明 <-> 该类型的值。

// 不含自由 binder 的 MLTT 类型现在也可以直接出现在类型别名右侧。
export type ZeroEqualsZero: Type0 = Eq<Nat, Zero, Zero>;

// -----------------------------------------------------------------------------
// 6. J：从反身情况推广到任意相等证明
// -----------------------------------------------------------------------------
//
// Motive 描述要对 left、right 和它们的相等证明建立什么结论；
// reflexivityCase 只需处理 value = value。J（path induction）把这个结果
// 推广到任意 proof: Eq<Nat, left, right>。

export type PathInduction: Type1 =
  (Motive: (left: Nat) -> (right: Nat) -> (proof: Eq<Nat, left, right>) -> Type0) ->
  (reflexivityCase: (value: Nat) -> Motive<value, value, Refl<Nat, value>>) ->
  (left: Nat) ->
  (right: Nat) ->
  (proof: Eq<Nat, left, right>) ->
  Motive<left, right, proof>;

// proof 是 Refl 时，J 会计算为 reflexivityCase<value>。
export type PathInductionComputation: Type1 =
  (Motive: (left: Nat) -> (right: Nat) -> (proof: Eq<Nat, left, right>) -> Type0) ->
  (reflexivityCase: (value: Nat) -> Motive<value, value, Refl<Nat, value>>) ->
  (value: Nat) ->
  Eq<
    Motive<value, value, Refl<Nat, value>>,
    J<Nat, Motive, reflexivityCase, value, value, Refl<Nat, value>>,
    reflexivityCase<value>
  >;

// Lam 写 term-level lambda，Ann 给它显式类型；因此闭合的 J 计算也能直接出现。
export type ClosedPathComputation: Type0 = Eq<
  Nat,
  J<
    Nat,
    Ann<
      Lam<(left: Nat) -> Lam<(right: Nat) -> Lam<(proof: Eq<Nat, left, right>) -> Nat>>>,
      (left: Nat) -> (right: Nat) -> (proof: Eq<Nat, left, right>) -> Type0
    >,
    Ann<Lam<(value: Nat) -> Zero>, (value: Nat) -> Nat>,
    Zero,
    Zero,
    Refl<Nat, Zero>
  >,
  Zero
>;

// -----------------------------------------------------------------------------
// 7. Sigma：第二项的类型依赖第一项
// -----------------------------------------------------------------------------
//
// 普通 tuple [A, B] 的第二项类型 B 是固定的。
// Sigma<(x: A) -> B> 允许 B 引用实际的第一项 x，
// 因此可以装载“数据 + 关于该数据的证明”。
//
// 下面的第一项是自然数 value，第二项必须证明 value = N。

export type SigmaFirstComputation: Type0 =
  (N: Nat) ->
  Eq<
    Nat,
    First<Pair<Sigma<(value: Nat) -> Eq<Nat, value, N>>, N, Refl<Nat, N>>>,
    N
  >;

export type SigmaSecondComputation: Type0 =
  (N: Nat) ->
  Eq<
    Eq<Nat, N, N>,
    Second<Pair<Sigma<(value: Nat) -> Eq<Nat, value, N>>, N, Refl<Nat, N>>>,
    Refl<Nat, N>
  >;

// First<Pair<...>> 归约为 N，Second<Pair<...>> 归约为 Refl<Nat, N>。
// 这些是 MLTT 内核的计算规则，不是字符串替换。

// 闭合的 Sigma 类型也可以脱离 Pi 上下文直接声明。
export type SingletonNat: Type0 =
  Sigma<(value: Nat) -> Eq<Nat, value, Zero>>;
