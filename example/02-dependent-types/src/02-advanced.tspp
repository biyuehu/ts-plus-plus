// =============================================================================
// 高级篇：与 TypeScript 类型组合，以及定义相等
// =============================================================================
//
// MLTT 负责 binder、universe、类型应用和定义相等；union、泛型、keyof、
// mapped type 等仍由原来的 TypeScript checker 处理。

type Box<T> = { value: T };

// -----------------------------------------------------------------------------
// 1. 嵌入普通 TypeScript 类型
// -----------------------------------------------------------------------------

export type BuiltinResult: Type1 = (A: Type0) -> string;
export type UnionResult: Type1 = (A: Type0) -> A | string;
export type IntersectionResult: Type1 = (A: Type0) -> A & object;
export type GenericReferenceResult: Type1 = (A: Type0) -> Box<A>;
export type KeysOf: Type1 = (A: Type0) -> keyof A;
export type PropertyResult: Type1 = (A: Type0) -> { value: A }["value"];
export type ReadonlyShape: Type1 = (A: Type0) -> { readonly [K in keyof A]: A[K] };
export type ConditionalResult: Type1 = (A: Type0) -> A extends string ? number : boolean;

// -----------------------------------------------------------------------------
// 2. Alpha 等价和遮蔽
// -----------------------------------------------------------------------------

// binder 名字不同，但绑定结构相同，因此下面两个类型 alpha 等价。
export type IdentityWithA: Type1 =
  (A: Type0) -> (value: A) -> A;

export type IdentityWithT: Type1 =
  (T: Type0) -> (item: T) -> T;

// 内层 A 遮蔽外层 A；最后一个 A 指向最近的 binder。
export type Shadowing: Type1 =
  (A: Type0) -> (A: Type0) -> A;

// -----------------------------------------------------------------------------
// 3. TypeScript 结构等价
// -----------------------------------------------------------------------------

type LeftShape = { value: string };
type RightShape = { value: string };

// external type 不比较 alias 名字，而是继续采用 TS 的结构类型语义。
export type WithLeftShape: Type1 = (A: Type0) -> LeftShape;
export type WithRightShape: Type1 = (A: Type0) -> RightShape;

// 结构等价也会穿过 MLTT binder。
export type WithGenericAlias: Type1 = (A: Type0) -> Box<A>;
export type WithStructuralBody: Type1 = (T: Type0) -> { value: T };

// MLTT 部分先比较归一化 term；遇到 external type 时，再委托 TS checker
// 进行严格 identity 或双向结构 assignability 检查。

// -----------------------------------------------------------------------------
// 4. 与运行时 TypeScript 函数衔接
// -----------------------------------------------------------------------------

export type RuntimeIdentity: Type1 =
  (A: Type0) -> (value: A) -> A;

// 显式注解的 TS 泛型函数可与等价 Pi 类型互相赋值。
const ordinaryIdentity = <A>(value: A): A => value;
export const dependentIdentity: RuntimeIdentity = ordinaryIdentity;

// Type0 binder 作为擦除的类型参数；运行时只需传 value。
// 调用会复用 TypeScript 原有的泛型推断。
export const explicitIdentityResult = dependentIdentity<string>("explicit");
export const inferredIdentityResult = dependentIdentity("inferred");

// -----------------------------------------------------------------------------
// 5. Nat 索引与数字字面量推断
// -----------------------------------------------------------------------------

type Vector<N extends number, A> = { length: N; value: A };

// Nat、Zero 和 Succ 是 MLTT 内核原语，不是用 number alias 伪装的类型。
export type EmptyVector: Type1 = (A: Type0) -> Vector<Zero, A>;
export type TwoVector: Type1 = (A: Type0) -> Vector<Succ<Succ<Zero>>, A>;

// 受限的类型级计算只归约内核原语；这里的 NatAdd 会结构递归到 2。
export type ComputedTwoVector: Type1 =
  (A: Type0) -> Vector<NatAdd<Succ<Zero>, Succ<Zero>>, A>;

// 进入 TS 调用桥接时，(N: Nat) 投影为 N extends number 和一个运行时参数。
export type VectorBuilder: Type1 =
  (A: Type0) -> (value: A) -> (N: Nat) -> Vector<N, A>;

export declare const buildVector: VectorBuilder;
export const pair = buildVector("item", 2); // Vector<2, string>
