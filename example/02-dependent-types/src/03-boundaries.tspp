// =============================================================================
// 边界篇：哪些是当前能力，哪些还不是
// =============================================================================
//
// 本篇不引入新概念，只帮助你建立正确预期。

// -----------------------------------------------------------------------------
// 1. TS++ 是“在 TypeScript 中嵌入 MLTT”
// -----------------------------------------------------------------------------
//
//   - object、union、keyof、mapped/conditional type 由 TS checker 处理；
//   - universe、Pi、Nat、Eq、Sigma 及定义相等由 MLTT 内核处理；
//   - external 边界负责在两者之间传递语义。

export type Identity: Type1 = (A: Type0) -> A;

// external alias 保留真实 kind。Identity 位于 Type1，不会被降级为 Type0。
export type HigherCodomain: Type1 =
  (ignored: string) -> Identity;

// -----------------------------------------------------------------------------
// 2. 当前表面语法的入口
// -----------------------------------------------------------------------------
//
// Pi 仍是引入依赖 binder 的入口，但闭合的 MLTT 类型不再依赖 Pi 外壳。
export type DirectProof: Type0 = Eq<Nat, Zero, Zero>;
export type DirectSigma: Type0 =
  Sigma<(value: Nat) -> Eq<Nat, value, Zero>>;
//
// Eq/Refl/J、NatElim 和 Pair/First/Second 可作为类型参数中的 MLTT term；
// `Lam` + `Ann` 提供显式、可检查的 term-level lambda。隐式参数、holes 和
// 通用 unification 仍不属于表面语法。

// -----------------------------------------------------------------------------
// 3. 运行时桥接的边界
// -----------------------------------------------------------------------------
//
// 目前主要支持：前导 Type0 binder + 普通值参数 + Nat/Bool 索引参数。
// Type0 binder 成为擦除的 TS 类型参数；Nat binder 同时成为
// `N extends number` 和运行时数字参数；调用点还要求实参具有非负安全整数
// 字面量类型。动态 number、负数和小数会被拒绝，避免破坏 Nat 语义。
// Bool binder 成为 `B extends boolean` 和运行时布尔参数；true/false 精确
// 选择分支，动态 boolean 的结果则是两个分支的 union。
// 开放的 IfType/TypeMatch 会桥接为非分布式的双向条件类型，从而按精确
// 类型而不是 `extends` 子类型关系选择结果。
//
// 尚未纳入桥接的有：可选/剩余参数、默认/约束类型参数、
// 高阶运行时 binder，以及 Sigma 的专用 JavaScript 运行时表示。

// -----------------------------------------------------------------------------
// 4. 错误实验
// -----------------------------------------------------------------------------
//
// 以下反例由 @ts-expect-error 保护，运行 `npm run check` 会同时验证它们仍会报错。

// Missing 没有被任何 binder 引入。
// @ts-expect-error -- Missing 是未绑定名称
export type UnboundName: Type1 = (A: Type0) -> Missing;

// `(A: Type0) -> A` 位于 Type1，不能声明为 Type0。
// @ts-expect-error -- 实际 universe 为 Type1
export type WrongUniverse: Type0 = (A: Type0) -> A;

// Succ 只能接收 Nat，string 是类型，不是自然数项。
// @ts-expect-error -- Succ 只能接收 Nat
export type WrongSuccessor: Type0 = (N: Nat) -> Succ<string>;

// Nat 调用只接受非负安全整数字面量。
export declare const buildAt: (N: Nat) -> { index: N };
// @ts-expect-error -- 负数不是 Nat
buildAt(-1);
// @ts-expect-error -- 小数不是 Nat
buildAt(1.5);
// @ts-expect-error -- 超出安全整数范围
buildAt(9007199254740992);
declare let dynamicNumber: number;
// @ts-expect-error -- 动态 number 无法在编译期证明为 Nat
buildAt(dynamicNumber);

// Pair 的第二项必须满足 Sigma 中依赖第一项的类型。
export type WrongPair: Type0 =
  // @ts-expect-error -- Zero 不能证明任意 N 等于 Zero
  (N: Nat) ->
  Eq<
    Sigma<(value: Nat) -> Eq<Nat, value, N>>,
    Pair<Sigma<(value: Nat) -> Eq<Nat, value, N>>, N, Zero>,
    Pair<Sigma<(value: Nat) -> Eq<Nat, value, N>>, N, Refl<Nat, N>>
  >;

// union/intersection 不能把 Type1 的类型伪装成 Type0。
export type HiddenHigherUniverse: Type1 =
  // @ts-expect-error -- union 的右侧位于 Type1
  (A: Type0) -> A | ((B: Type0) -> B);

// -----------------------------------------------------------------------------
// 5. 明确不在当前范围内的能力
// -----------------------------------------------------------------------------
//
//   - 用户可声明的通用 inductive family；
//   - dependent pattern matching；
//   - 隐式参数、holes 和通用 unification；
//   - 让任意 JavaScript 表达式参与类型级计算。
//
// 后两项是明确保留的边界。类型级计算只执行内核已知且可证明
// 终止的规则，例如 beta reduction、NatAdd、NatElim 和 Sigma 投影。
