// =============================================================================
// 类型匹配篇：把类型本身作为分支条件
// =============================================================================
//
// Bool 的分支条件是值；本篇的分支条件是类型。它是一种受控的反射能力，
// 并不是普通 MLTT 参数多态自然拥有的行为。

// -----------------------------------------------------------------------------
// 1. IfType 做一次精确类型比较
// -----------------------------------------------------------------------------
//
// IfType<subject, pattern, whenEqual, otherwise> 比较前两个类型是否定义相等。

export type NumberResult: Type0 =
  IfType<number, number, string, boolean>;

export type FallbackResult: Type0 =
  IfType<string, number, string, boolean>;

// 这里的“相等”不是 TypeScript 的 A extends B。extends 问的是可赋值性；
// IfType 问的是两边经过别名展开和内核计算后是否为同一个类型。

type Animal = { name: string };
type Dog = { name: string; bark(): void };

// Dog 可赋给 Animal，但并不与 Animal 精确相等，所以结果是 false。
export type AssignableIsNotEqual: Type0 =
  IfType<Dog, Animal, true, false>;

// TypeScript 对对象采用结构语义；形状相同的别名可以精确匹配。
type LeftShape = { value: string };
type RightShape = { value: string };
export type StructuralAliasMatch: Type0 =
  IfType<LeftShape, RightShape, "equal", "different">;

// -----------------------------------------------------------------------------
// 2. 比较有三种状态：equal、apart、stuck
// -----------------------------------------------------------------------------
//
//   equal：已经能证明相同，选择相等分支；
//   apart：已经能证明不同，选择后备分支；
//   stuck：subject 还是开放 binder，信息不足，暂不选择。
//
// stuck 不是错误，也不会偷偷选择 otherwise。A 被实际类型替换后，归约继续。

export type NumberOrFallback: Type1 =
  (A: Type0) -> IfType<A, number, Bool, string>;

// -----------------------------------------------------------------------------
// 3. TypeMatch 把多个精确比较按顺序排列
// -----------------------------------------------------------------------------
//
// Case<pattern, result> 表示一条规则，末尾必须是 Default<result>。

export type MatchedString: Type0 =
  TypeMatch<
    string,
    Case<string, number>,
    Case<number, string>,
    Default<boolean>
  >;

// 顺序很重要。遇到 equal 就返回该分支；遇到 apart 才继续下一条。
// 如果较早的 Case 对开放 subject 得到 stuck，整个匹配也保持 stuck，不能越过
// 它猜测后面的分支。

export type MatchRuntimeValue: Type1 =
  (A: Type0) ->
  (value: A) ->
  TypeMatch<
    A,
    Case<string, number>,
    Case<number, string>,
    Default<boolean>
  >;

export declare const matchRuntimeValue: MatchRuntimeValue;

declare let runtimeText: string;
declare let runtimeNumber: number;
declare let runtimeBoolean: boolean;

export const matchedText = matchRuntimeValue(runtimeText);       // number
export const matchedNumber = matchRuntimeValue(runtimeNumber);   // string
export const matchedDefault = matchRuntimeValue(runtimeBoolean); // boolean

// -----------------------------------------------------------------------------
// 4. union 作为一个整体参与匹配
// -----------------------------------------------------------------------------
//
// 精确匹配不会像裸 TypeScript conditional type 那样自动分发 union。
// string | number 既不等于 string，也不等于 number，因此走 Default。

export type WholeUnionResult: Type0 =
  TypeMatch<
    string | number,
    Case<string, "text">,
    Case<number, "numeric">,
    Default<"whole union">
  >;
