// =============================================================================
// TS++ 原生依赖类型：从零开始
// =============================================================================
//
// 不需要预先学过 MLTT。先记住三个直觉：
//
//   1. 普通值有类型，例如 123 的类型是 number。
//   2. 在这里，类型本身也会被分类；Type0 可以理解成“普通类型的集合”。
//   3. Type0 自己不能属于自己，它位于更高一层 Type1。
//
// 层级关系可以画成：
//
//   普通值  : 某个普通类型
//   普通类型: Type0
//   Type0   : Type1
//   Type1   : Type2
//
// 冒号读作“左边属于右边”或“左边具有右边这个 kind”。

// -----------------------------------------------------------------------------
// 第 1 步：认识 universe（类型宇宙）
// -----------------------------------------------------------------------------

// Type0 是一个类型宇宙，而 Type0 本身位于 Type1。
export type UniverseZero: Type1 = Type0;

// 同理，Type1 位于 Type2。宇宙可以继续向上延伸。
export type UniverseOne: Type2 = Type1;

// -----------------------------------------------------------------------------
// 第 2 步：阅读依赖函数语法
// -----------------------------------------------------------------------------
//
//   (参数名: 参数类型) -> 返回类型
//
// 对比：原有 TypeScript 函数类型继续使用 `=>`，并且不允许返回类型依赖参数值。
export type OrdinaryStringFunction = (value: string) => string;

// 它和普通函数最重要的区别是：右侧“返回类型”可以使用左侧参数名。
// `->` 从右向左结合，所以：
//
//   (A: Type0) -> (value: A) -> A
//
// 等价于：
//
//   (A: Type0) -> ((value: A) -> A)

// 这个类型描述“多态恒等函数”：
//
//   - 调用者先选择一个普通类型 A；
//   - 再提供一个属于 A 的值 value；
//   - 最终必须得到一个 A。
//
// 第二段中的 `value: A` 和最后的 `A` 都依赖第一段选出的 A，
// 因而它不是几个互不相关的普通箭头，而是一个真正的依赖函数类型。
export type PolymorphicIdentity: Type1 =
  (A: Type0) -> (value: A) -> A;

// -----------------------------------------------------------------------------
// 第 3 步：参数不一定真的被依赖
// -----------------------------------------------------------------------------

// 如果右侧没有使用参数名，它仍然是合法的 Pi/依赖函数，只是退化成非依赖情形。
// 这里表示：“给定任意普通类型 A，产生一个普通类型”。
export type TypeFamilyShape: Type1 =
  (A: Type0) -> Type0;

// 这里的结果依赖 A，但不依赖 B：无论第二次选择什么类型，结果都是第一次选择的 A。
export type ConstantTypeFunction: Type1 =
  (A: Type0) -> (B: Type0) -> A;

// -----------------------------------------------------------------------------
// 第 4 步：类型族也可以作为参数
// -----------------------------------------------------------------------------
//
// F 的类型是 `(A: Type0) -> Type0`，可以把它理解为“接收类型并返回类型的类型族”。
// `F<A>` 表示把类型族 F 应用到 A。
//
// 整体含义是：给我一个类型族 F 和一个类型 A，我就能得到 F<A>。
export type ApplyTypeFamily: Type1 =
  (F: (A: Type0) -> Type0) -> (A: Type0) -> F<A>;

// -----------------------------------------------------------------------------
// 第 5 步：它已经是正式的 compiler Type
// -----------------------------------------------------------------------------

// 普通类型别名可以引用并传播依赖函数类型；这里不会退化成 unknown。
export type IdentityAlias: Type1 = PolymorphicIdentity;

// binder（绑定变量）的名字只是为了让人阅读。
// 下面两个类型虽然分别使用 A/value 与 T/item，但结构和含义完全相同。
// checker 会用 MLTT 的定义相等判断它们相等，而不是比较变量名。
export type IdentityWithDifferentNames: Type1 =
  (T: Type0) -> (item: T) -> T;

// -----------------------------------------------------------------------------
// 第 6 步：理解作用域和遮蔽（进阶，可暂时跳过）
// -----------------------------------------------------------------------------

// 内层的 A 会遮蔽外层的 A，因此最后一个 A 指向最近的、也就是内层的 binder。
// 编译器内部会把名字转换成 De Bruijn index，使相等判断不受命名方式影响。
export type Shadowing: Type1 =
  (A: Type0) -> (A: Type0) -> A;

// -----------------------------------------------------------------------------
// 第 7 步：亲手观察错误
// -----------------------------------------------------------------------------
//
// 可以逐条取消注释，然后运行 `npm run check`。

// Missing 没有被任何左侧 binder 引入，因此会报告“未绑定的 MLTT 类型变量”。
// export type UnboundName: Type1 = (A: Type0) -> Missing;

// `(A: Type0) -> A` 位于 Type1，却被错误地声明为 Type0。
// export type WrongUniverse: Type0 = (A: Type0) -> A;

// 普通 TypeScript 类型也可以嵌在依赖函数里；它们仍由原有 checker 检查。
export type BuiltinResult: Type1 = (A: Type0) -> string;
export type UnionResult: Type1 = (A: Type0) -> A | string;
export type IntersectionResult: Type1 = (A: Type0) -> A & object;
export type KeysOf: Type1 = (A: Type0) -> keyof A;
export type PropertyResult: Type1 = (A: Type0) -> { value: A }["value"];
export type ReadonlyShape: Type1 = (A: Type0) -> { readonly [K in keyof A]: A[K] };
