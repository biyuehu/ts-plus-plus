{
  "name": "ts-plus-plus-monorepo",
  "private": true,
  "devDependencies": {
    "dprint": "^0.49.1",
    "lefthook": "^2.2.2"
  },
  "scripts": {
    "prepare": "pnpm setup-hooks",
    "test": "pnpm --filter ts-plus-plus test",
    "test:eslint-rules": "pnpm --filter ts-plus-plus test:eslint-rules",
    "build": "pnpm build:compiler && pnpm build:language-server && pnpm build:tests",
    "build:compiler": "pnpm --filter ts-plus-plus build:compiler",
    "build:language-server": "pnpm --filter tspp-language-server build",
    "build:playground": "pnpm --filter tspp-playground build",
    "build:all": "pnpm build && pnpm build:playground",
    "build:tests": "pnpm --filter ts-plus-plus build:tests",
    "build:tests:notypecheck": "pnpm --filter ts-plus-plus build:tests:notypecheck",
    "build:editor": "pnpm build:compiler && pnpm build:language-server",
    "playground:bundle": "pnpm --filter tspp-playground bundle",
    "playground:debug": "pnpm build:compiler && pnpm --filter tspp-playground bundle:dev && pnpm --filter tspp-playground dev",
    "playground:examples": "pnpm --filter tspp-playground examples",
    "playground:dev": "pnpm --filter tspp-playground dev",
    "example": "pnpm build:editor && code --new-window --disable-extension=shalldie.background --disable-extension=rbuckton.tsserver-live-reload --disable-extension=wakatime.vscode-wakatime --disable-extension=fittentech.fitten-code --disable-extension=biomejs.biome --extensionDevelopmentPath=./packages/vscode-extension ./packages/examples",
    "example:open": "code --new-window --disable-extension=shalldie.background --disable-extension=rbuckton.tsserver-live-reload --disable-extension=wakatime.vscode-wakatime --disable-extension=fittentech.fitten-code --disable-extension=biomejs.biome --extensionDevelopmentPath=./packages/vscode-extension ./packages/examples",
    "clean": "pnpm --filter ts-plus-plus clean",
    "lint": "pnpm --filter ts-plus-plus lint",
    "knip": "pnpm --filter ts-plus-plus knip",
    "format": "pnpm format:compiler && pnpm format:root",
    "format:check": "pnpm format:compiler:check && pnpm format:root:check",
    "format:compiler": "pnpm --filter ts-plus-plus format",
    "format:compiler:check": "pnpm --filter ts-plus-plus format:check",
    "format:root": "dprint fmt --config packages/compiler/.dprint.jsonc package.json lefthook.yml .github .vscode",
    "format:root:check": "dprint check --config packages/compiler/.dprint.jsonc package.json lefthook.yml .github .vscode",
    "contributors": "node packages/compiler/scripts/generate-contributors.mjs",
    "setup-hooks": "node packages/compiler/scripts/link-hooks.mjs && node packages/compiler/scripts/install-lefthook.mjs",
    "check:examples": "pnpm --filter @tspp/examples check"
  },
  "packageManager": "pnpm@12.4.2",
  "volta": {
    "node": "22.22.2"
  }
}
