{
  "name": "ts-plus-plus",
  "workspaces": [
    "packages/vscode-extension",
    "packages/examples"
  ],
  "author": "",
  "homepage": "https://github.com/tspp-lang/tspp#readme",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "description": "The experimental TS++ compiler with explicitly enabled type-system features.",
  "keywords": [
    "ts-plus-plus",
    "tspp",
    "typescript-plus-plus",
    "TypeScript",
    "compiler",
    "language",
    "javascript"
  ],
  "bugs": {
    "url": "https://github.com/tspp-lang/tspp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tspp-lang/tspp.git"
  },
  "main": "./lib/typescript.js",
  "typings": "./lib/typescript.d.ts",
  "bin": {
    "tspp": "./bin/tsc",
    "tsppserver": "./bin/tsserver"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "bin",
    "lib",
    "!lib/enu",
    "LICENSE.txt",
    "README.md",
    "SECURITY.md",
    "ThirdPartyNoticeText.txt",
    "!**/.gitattributes"
  ],
  "dependencies": {
    "z3-solver": "^5.2.0"
  },
  "devDependencies": {
    "@dprint/formatter": "^0.4.1",
    "@dprint/typescript": "0.93.4",
    "@esfx/canceltoken": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^4.3.20",
    "@types/minimist": "^1.2.5",
    "@types/mocha": "^10.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "latest",
    "@types/source-map-support": "^0.5.10",
    "@types/which": "^3.0.4",
    "@typescript-eslint/rule-tester": "^8.56.1",
    "@typescript-eslint/type-utils": "^8.56.1",
    "@typescript-eslint/utils": "^8.56.1",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "chokidar": "^4.0.3",
    "diff": "^8.0.3",
    "dprint": "^0.49.1",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.2",
    "eslint-plugin-regexp": "^3.0.0",
    "fast-xml-parser": "^5.4.1",
    "glob": "^10.5.0",
    "globals": "^17.4.0",
    "hereby": "^1.12.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^5.85.0",
    "lefthook": "^2.2.2",
    "minimist": "^1.2.8",
    "mocha": "^10.8.2",
    "mocha-fivemat-progress-reporter": "^0.1.0",
    "monocart-coverage-reports": "^2.12.9",
    "ms": "^2.1.3",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.2",
    "source-map-support": "^0.5.21",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vscode-languageclient": "9.0.1",
    "which": "^3.0.1"
  },
  "scripts": {
    "prepare": "npm run setup-hooks",
    "test": "hereby runtests-parallel --light=false",
    "test:eslint-rules": "hereby run-eslint-rules-tests",
    "build": "npm run build:compiler && npm run build:language-server && npm run build:tests",
    "build:compiler": "hereby local",
    "build:language-server": "npx --yes pnpm@12.4.2 --dir packages/language-server build",
    "build:editor": "npm run build:compiler && npm run build:language-server",
    "example": "npm run build:editor && code --new-window --disable-extension=shalldie.background --disable-extension=rbuckton.tsserver-live-reload --disable-extension=wakatime.vscode-wakatime --disable-extension=fittentech.fitten-code --disable-extension=biomejs.biome --extensionDevelopmentPath=./packages/vscode-extension ./packages/examples",
    "example:open": "code --new-window --disable-extension=shalldie.background --disable-extension=rbuckton.tsserver-live-reload --disable-extension=wakatime.vscode-wakatime --disable-extension=fittentech.fitten-code --disable-extension=biomejs.biome --extensionDevelopmentPath=./packages/vscode-extension ./packages/examples",
    "build:tests": "hereby tests",
    "build:tests:notypecheck": "hereby tests --no-typecheck",
    "clean": "hereby clean",
    "lint": "hereby lint",
    "knip": "hereby knip",
    "format": "dprint fmt",
    "contributors": "node scripts/generate-contributors.mjs",
    "setup-hooks": "node scripts/link-hooks.mjs && lefthook install"
  },
  "browser": {
    "fs": false,
    "os": false,
    "path": false,
    "crypto": false,
    "buffer": false,
    "source-map-support": false,
    "inspector": false,
    "perf_hooks": false
  },
  "packageManager": "npm@8.19.4",
  "volta": {
    "node": "22.22.0",
    "npm": "8.19.4"
  }
}
