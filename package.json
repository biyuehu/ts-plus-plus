{
  "name": "ts-plus-plus-monorepo",
  "private": true,
  "workspaces": [
    "packages/compiler",
    "packages/vscode-extension",
    "packages/examples"
  ],
  "devDependencies": {
    "lefthook": "^2.2.2"
  },
  "scripts": {
    "prepare": "npm run setup-hooks",
    "test": "npm run test --workspace=ts-plus-plus",
    "test:eslint-rules": "npm run test:eslint-rules --workspace=ts-plus-plus",
    "build": "npm run build:compiler && npm run build:language-server && npm run build:tests",
    "build:compiler": "npm run build:compiler --workspace=ts-plus-plus",
    "build:language-server": "npx --yes pnpm@12.4.2 --dir packages/language-server build",
    "build:playground": "npm --prefix packages/playground run build",
    "build:all": "npm run build && npm run build:playground",
    "build:tests": "npm run build:tests --workspace=ts-plus-plus",
    "build:tests:notypecheck": "npm run build:tests:notypecheck --workspace=ts-plus-plus",
    "build:editor": "npm run build:compiler && npm run build:language-server",
    "playground:bundle": "npm --prefix packages/playground run bundle",
    "playground:debug": "npm run build:compiler && npm --prefix packages/playground run bundle:dev && npm --prefix packages/playground run dev",
    "playground:examples": "npm --prefix packages/playground run examples",
    "playground:dev": "npm --prefix packages/playground run dev",
    "example": "npm run build:editor && code --new-window --disable-extension=shalldie.background --disable-extension=rbuckton.tsserver-live-reload --disable-extension=wakatime.vscode-wakatime --disable-extension=fittentech.fitten-code --disable-extension=biomejs.biome --extensionDevelopmentPath=./packages/vscode-extension ./packages/examples",
    "example:open": "code --new-window --disable-extension=shalldie.background --disable-extension=rbuckton.tsserver-live-reload --disable-extension=wakatime.vscode-wakatime --disable-extension=fittentech.fitten-code --disable-extension=biomejs.biome --extensionDevelopmentPath=./packages/vscode-extension ./packages/examples",
    "clean": "npm run clean --workspace=ts-plus-plus",
    "lint": "npm run lint --workspace=ts-plus-plus",
    "knip": "npm run knip --workspace=ts-plus-plus",
    "format": "npm run format:compiler && npm run format:root",
    "format:check": "npm run format:compiler:check && npm run format:root:check",
    "format:compiler": "npm run format --workspace=ts-plus-plus",
    "format:compiler:check": "npm run format:check --workspace=ts-plus-plus",
    "format:root": "dprint fmt --config packages/compiler/.dprint.jsonc package.json lefthook.yml .github .vscode",
    "format:root:check": "dprint check --config packages/compiler/.dprint.jsonc package.json lefthook.yml .github .vscode",
    "contributors": "node packages/compiler/scripts/generate-contributors.mjs",
    "setup-hooks": "node packages/compiler/scripts/link-hooks.mjs && node packages/compiler/scripts/install-lefthook.mjs",
    "check:examples": "npm run check --workspace=@tspp/examples"
  },
  "packageManager": "npm@8.19.4",
  "volta": {
    "node": "22.22.0",
    "npm": "8.19.4"
  }
}
