/**
 * 展示：宏读取目标 AST，并在编译期检查代码规则。
 * 运行：npm run check
 * 预期：检查通过，不生成额外代码。
 */
import * as ts from "../../../../built/local/typescript";

// 宏函数在编译期执行。targets 是调用处传入的声明，context 提供诊断等能力。
export macro function requireReturnStatement(
  targets: readonly ts.MacroTarget[],
  context: ts.MacroContext,
): ts.MacroReturn {
  if (targets.length !== 1) {
    return context.fail(`expected 1 target, received ${targets.length}`);
  }

  const target = targets[0];
  if (!ts.isFunctionDeclaration(target.node)) {
    return context.fail(`${target.name} must be a function declaration`);
  }

  const hasReturn = target.node.body?.statements.some(ts.isReturnStatement) ?? false;
  return hasReturn
    ? undefined
    : context.fail(`${target.name} must contain a return statement`);
}

export function readAnswer(): number {
  return 42;
}

// 显式写出 macro 才会在编译期执行。检查成功后，这条语句不会进入 JavaScript。
macro requireReturnStatement(readAnswer);

/*
 * 失败实验：取消下面代码的注释，再运行 npm run check。
 * 编译器会在宏调用处报告 “doNothing must contain a return statement”。
 */

