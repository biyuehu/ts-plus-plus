{
  "name": "tspp-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Online playground for ts-plus-plus (TS++) — Monaco editor + forked language-service worker over the tspp compiler bundle.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-monaco-worker.mjs",
    "spike": "node spike/load-spike.mjs",
    "worker-spike": "node scripts/worker-spike.mjs",
    "z3-spike": "node scripts/z3-load-spike.mjs && node scripts/z3-bundled-spike.mjs",
    "z3:worker": "node scripts/build-z3-worker.mjs",
    "bundle": "node scripts/build-bundle.mjs",
    "bundle:dev": "node scripts/build-bundle.mjs --dev",
    "examples": "node scripts/generate-examples.mjs",
    "dev": "node scripts/patch-monaco-worker.mjs && vite",
    "build": "node scripts/build-z3-worker.mjs && node scripts/patch-monaco-worker.mjs && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0",
    "ts-plus-plus": "file:../compiler"
  },
  "devDependencies": {
    "lz-string": "^1.5.0",
    "sass": "^1.105.2",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "esbuild": "^0.27.3"
  }
}
