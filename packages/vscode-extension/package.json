{
  "name": "tspp-development",
  "displayName": "TS++ Development",
  "description": "Development host support for the TS++ compiler in this repository.",
  "version": "0.0.1",
  "publisher": "tspp-local",
  "private": true,
  "dependencies": {
    "@tspp/examples": "workspace:*",
    "ts-plus-plus": "workspace:*",
    "tspp-language-server": "workspace:*",
    "vscode-languageclient": "9.0.1"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:tspp",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "icon": "tspp.svg",
  "contributes": {
    "languages": [
      {
        "id": "tspp",
        "aliases": [
          "TS++",
          "TypeScript++"
        ],
        "extensions": [
          ".tspp"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./tspp.svg",
          "dark": "./tspp.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tspp",
        "scopeName": "source.tspp",
        "path": "./syntaxes/tspp.tmLanguage.json"
      },
      {
        "scopeName": "tspp.kind-operators",
        "path": "./syntaxes/tspp-kind-operators.tmLanguage.json",
        "injectTo": [
          "source.tspp",
          "source.ts"
        ]
      },
      {
        "scopeName": "tspp.operators",
        "path": "./syntaxes/tspp-operators.tmLanguage.json",
        "injectTo": [
          "source.tspp",
          "source.ts"
        ],
        "embeddedLanguages": {
          "meta.embedded.inline.tspp-operator": "plaintext"
        }
      },
      {
        "scopeName": "tspp.nominal-declarations",
        "path": "./syntaxes/tspp-nominal-declarations.tmLanguage.json",
        "injectTo": [
          "source.tspp",
          "source.ts"
        ]
      },
      {
        "scopeName": "tspp.macros",
        "path": "./syntaxes/tspp-macros.tmLanguage.json",
        "injectTo": [
          "source.tspp",
          "source.ts"
        ]
      },
      {
        "scopeName": "tspp.formal-contracts",
        "path": "./syntaxes/tspp-formal-contracts.tmLanguage.json",
        "injectTo": [
          "source.tspp",
          "source.ts"
        ]
      },
      {
        "scopeName": "tspp.type-computation",
        "path": "./syntaxes/tspp-type-computation.tmLanguage.json",
        "injectTo": [
          "source.tspp",
          "source.ts"
        ]
      },
      {
        "scopeName": "tspp.modern-syntax",
        "path": "./syntaxes/tspp-modern-syntax.tmLanguage.json",
        "injectTo": [
          "source.tspp",
          "source.ts"
        ]
      }
    ],
    "commands": [
      {
        "command": "tspp.pickExample",
        "title": "TS++: Choose Example"
      },
      {
        "command": "tspp.openAllExamples",
        "title": "TS++: Open All Examples"
      },
      {
        "command": "tspp.openHigherKindedTypesExample",
        "title": "TS++: Open Higher-Kinded Types Example"
      },
      {
        "command": "tspp.openDependentTypesExample",
        "title": "TS++: Open Dependent Types Example"
      },
      {
        "command": "tspp.openNewtypeAndDataExample",
        "title": "TS++: Open Newtype and Data Example"
      },
      {
        "command": "tspp.openMacrosExample",
        "title": "TS++: Open Compile-Time Macros Example"
      },
      {
        "command": "tspp.openFormalContractsExample",
        "title": "TS++: Open Formal Contracts Example"
      },
      {
        "command": "tspp.openTypeComputationExample",
        "title": "TS++: Open Type Computation Example"
      },
      {
        "command": "tspp.openTypescriptInteropExample",
        "title": "TS++: Open TypeScript Interop Example"
      },
      {
        "command": "tspp.showExpandedSource",
        "title": "TS++: Show Expanded Source",
        "icon": "$(preview)"
      },
      {
        "command": "tspp.showVerificationSmt",
        "title": "TS++: Show Verification SMT-LIB",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "tspp.restartLanguageServer",
        "title": "TS++: Restart Language Server"
      },
      {
        "command": "tspp.openLanguageServerLog",
        "title": "TS++: Open Language Server Log"
      }
    ],
    "configuration": {
      "title": "TS++",
      "properties": {
        "tspp.tsdk": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Path to a TS++ SDK root containing lib/tsserver.js, its lib directory, or directly to tsserver.js. Relative paths are resolved from the first workspace folder."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "tspp.showExpandedSource",
          "when": "editorLangId == tspp && resourceExtname == .tspp",
          "group": "navigation@10"
        },
        {
          "command": "tspp.showVerificationSmt",
          "when": "editorLangId == tspp && resourceExtname == .tspp",
          "group": "navigation@11"
        }
      ]
    }
  }
}
