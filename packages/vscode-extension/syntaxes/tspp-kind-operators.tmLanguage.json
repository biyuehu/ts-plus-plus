{
  "name": "TS++ Kind Operators",
  "scopeName": "tspp.kind-operators",
  "injectionSelector": "L:meta.type.declaration.ts -comment -string, L:meta.type.annotation.ts -comment -string, L:meta.type -comment -string",
  "patterns": [
    {
      "name": "support.type.builtin.tspp",
      "match": "\\b(?:Prop|Type(?:[0-9]+)?)\\b"
    }
  ]
}
