{
  "name": "TS++ Modern Syntax",
  "scopeName": "tspp.modern-syntax",
  "injectionSelector": "L:source.tspp -comment -string, L:source.ts -comment -string",
  "patterns": [
    {
      "comment": "def variable declaration and hover display",
      "name": "meta.var.expr.tspp",
      "begin": "\\b(def)\\b\\s+([_$[:alpha:]][_$[:alnum:]]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.ts"
        },
        "2": {
          "name": "variable.other.readwrite.ts"
        }
      },
      "end": "(?=[;\\r\\n])",
      "patterns": [
        {
          "include": "source.ts#type-annotation"
        },
        {
          "include": "source.ts#comment"
        },
        {
          "begin": "(=)\\s*",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.assignment.ts"
            }
          },
          "end": "(?=[;\\r\\n])",
          "patterns": [
            {
              "include": "source.ts"
            }
          ]
        }
      ]
    },
    {
      "name": "meta.do.expression.tspp",
      "begin": "\\b(do)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.loop.ts"
        },
        "2": {
          "name": "punctuation.definition.block.begin.ts"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.ts"
        }
      },
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    },
    {
      "comment": "Value-level let-in binding expression",
      "match": "\\b(let)\\b(?=[^;\\r\\n]*?\\b(in)\\b)",
      "captures": {
        "1": {
          "name": "keyword.control.flow.ts"
        }
      }
    },
    {
      "comment": "Value-level in keyword in let-in expression",
      "match": "(?<=\\blet\\b[^;\\r\\n]*?)\\b(in)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flow.ts"
        }
      }
    },
    {
      "comment": "do function/method body header: ) do { or : Type do {",
      "match": "\\bdo\\b(?=\\s*\\{)",
      "name": "keyword.control.loop.ts"
    },
    {
      "comment": "use binding keyword",
      "match": "\\b(use)\\b(?=[^;\\r\\n]*?<-)",
      "captures": {
        "1": {
          "name": "keyword.control.flow.ts"
        }
      }
    },
    {
      "comment": "use binding arrow",
      "match": "<-",
      "name": "meta.embedded.inline.tspp-operator keyword.operator.assignment.ts storage.type.function.arrow.ts"
    }
  ]
}
