import * as ts from "ts-plus-plus";

// 宏实现运行在编译器的 Node.js 进程中，并没有沙箱。这里显式声明 require 只是为了
// 获得类型；执行时拿到的是真正的 Node.js require，拥有与编译器相同的文件和模块权限。
declare function require(name: string): any;

/**
 * 读取示例自己的 package.json，并把包名固化进生成的 JavaScript。
 *
 * 这段读取只用于展示能力边界。真实项目应当只运行可信宏，并避免网络请求、写文件、
 * 修改环境或依赖当前时间等不可重复的副作用。
 */
export macro function exposePackageName(
  _targets: readonly ts.MacroTarget[],
  context: ts.MacroContext,
): ts.MacroResult {
  const packageJson = require("../package.json") as { name: string };

  return context.factory.createVariableStatement(
    [context.factory.createModifier(ts.SyntaxKind.ExportKeyword)],
    context.factory.createVariableDeclarationList(
      [
        context.factory.createVariableDeclaration(
          "MacroExamplePackageName",
          undefined,
          context.factory.createLiteralTypeNode(
            context.factory.createStringLiteral(packageJson.name),
          ),
          context.factory.createStringLiteral(packageJson.name),
        ),
      ],
      ts.NodeFlags.Const,
    ),
  );
}

macro exposePackageName();

const checkedPackageName: "tspp-example-04-macros" = MacroExamplePackageName;
console.log(checkedPackageName);

