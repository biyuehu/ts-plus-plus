// =============================================================================
// 类型匹配篇：把类型本身作为分支条件
// =============================================================================
//
// Bool 的分支条件是值；本篇的分支条件是类型。它是一种受控的反射能力，
// 并不是普通 MLTT 参数多态自然拥有的行为。

// -----------------------------------------------------------------------------
// 1. match mltt 做精确类型比较
// -----------------------------------------------------------------------------
//
// match mltt 从上到下比较 subject 与 pattern 是否定义相等，_ 是默认分支。

export type NumberResult: Type0 =
  match mltt number { number: string, _: boolean };

export type FallbackResult: Type0 =
  match mltt string { number: string, _: boolean };

// 这里的“相等”不是 TypeScript 的 A extends B。extends 问的是可赋值性；
// match mltt 问的是两边经过别名展开和内核计算后是否为同一个类型。

type Animal = { name: string };
type Dog = { name: string; bark(): void };

// Dog 可赋给 Animal，但并不与 Animal 精确相等，所以结果是 false。
export type AssignableIsNotEqual: Type0 =
  match mltt Dog { Animal: true, _: false };

// TypeScript 对对象采用结构语义；形状相同的别名可以精确匹配。
type LeftShape = { value: string };
type RightShape = { value: string };
export type StructuralAliasMatch: Type0 =
  match mltt LeftShape { RightShape: "equal", _: "different" };

// -----------------------------------------------------------------------------
// 2. 比较有三种状态：equal、apart、stuck
// -----------------------------------------------------------------------------
//
//   equal：已经能证明相同，选择相等分支；
//   apart：已经能证明不同，选择后备分支；
//   stuck：subject 还是开放 binder，信息不足，暂不选择。
//
// stuck 不是错误，也不会偷偷选择 otherwise。A 被实际类型替换后，归约继续。

export type NumberOrFallback: Type1 =
  (A: Type0) -> match mltt A { number: Bool, _: string };

// -----------------------------------------------------------------------------
// 3. 多分支 match mltt 把多个精确比较按顺序排列
// -----------------------------------------------------------------------------
//
// 每个 pattern: result 表示一条规则，末尾必须是 _: result。

export type MatchedString: Type0 =
  match mltt string {
    string: number,
    number: string,
    _: boolean
  };

// 顺序很重要。遇到 equal 就返回该分支；遇到 apart 才继续下一条。
// 如果较早的 Case 对开放 subject 得到 stuck，整个匹配也保持 stuck，不能越过
// 它猜测后面的分支。

export type MatchRuntimeValue: Type1 =
  {A: Type0} ->
  (value: A) ->
  match mltt A {
    string: number,
    number: string,
    _: boolean
  };

export declare const matchRuntimeValue: MatchRuntimeValue;

declare let runtimeText: string;
declare let runtimeNumber: number;
declare let runtimeBoolean: boolean;

export const matchedText = matchRuntimeValue(runtimeText);       // number
export const matchedNumber = matchRuntimeValue(runtimeNumber);   // string
export const matchedDefault = matchRuntimeValue(runtimeBoolean); // boolean

// -----------------------------------------------------------------------------
// 4. infer 在匹配成功时解构泛型参数
// -----------------------------------------------------------------------------
//
// Case 中的 infer T 引入一个只在该分支结果中可见的类型 binder。
// 匹配会先展开透明 type alias，再检查泛型构造器身份并递归匹配参数；
// Array<string> 匹配 Array<infer T> 时，T 被捕获为 string。

export type ElementOrSelf: Type1 =
  (A: Type0) ->
  match mltt A {
    Array<infer T>: T,
    _: A
  };

// pattern 可以嵌套；这里仅匹配恰好具有 Promise<Array<T>> 形状的类型。
export type NestedElementOrSelf: Type1 =
  (A: Type0) ->
  match mltt A {
    Promise<Array<infer T>>: T,
    _: A
  };

// 捕获仍遵守 equal / apart / stuck：开放的 A 不会提前走 Default，
// 而是在调用点获得实际类型后再决定并代入 T。
export type FirstArrayElement: Type1 =
  {A: Type0} ->
  (value: A) ->
  match mltt A {
    Array<infer T>: T,
    _: A
  };

export declare const firstArrayElement: FirstArrayElement;

declare let textArray: Array<string>;
declare let notArray: Date;
export const inferredElement = firstArrayElement(textArray); // string
export const inferredFallback = firstArrayElement(notArray); // Date

// “构造器相同”比 TypeScript 的结构可赋值更严格：tuple、ReadonlyArray、
// Array 的子接口和交叉类型都不是恰好一个 Array<T>，因此不会被解构。
// 但 type alias 是透明的，别名展开后仍然是同一个 Array 构造器。
type TextArrayAlias = Array<string>;
interface TaggedArray<T> extends Array<T> { readonly tag: "tagged" }
declare let aliasedTextArray: TextArrayAlias;
declare let readonlyTextArray: ReadonlyArray<string>;
declare let textTuple: [string];
declare let taggedTextArray: TaggedArray<string>;
declare let intersectedTextArray: Array<string> & { readonly tag: "tagged" };

export const inferredThroughAlias = firstArrayElement(aliasedTextArray);       // string
export const readonlyArrayFallback = firstArrayElement(readonlyTextArray);     // ReadonlyArray<string>
export const tupleFallback = firstArrayElement(textTuple);                     // [string]
export const derivedConstructorFallback = firstArrayElement(taggedTextArray);  // TaggedArray<string>
export const intersectionFallback = firstArrayElement(intersectedTextArray);   // Array<string> & { tag: "tagged" }

// 上面这些调用会投影为 TypeScript conditional type；对这些常见构造器结果与
// 内核一致。不过声明桥接无法编码构造器身份：两个成员完全相同、声明却不同的
// 泛型接口，可能被 TypeScript 结构类型系统视为匹配。核心 TypeMatch 没有此假阳性。

// -----------------------------------------------------------------------------
// 5. union 作为一个整体参与匹配
// -----------------------------------------------------------------------------
//
// 精确匹配不会像裸 TypeScript conditional type 那样自动分发 union。
// string | number 既不等于 string，也不等于 number，因此走 Default。

export type WholeUnionResult: Type0 =
  match mltt string | number {
    string: "text",
    number: "numeric",
    _: "whole union"
  };

// 旧的 TypeMatch/Case/Default 和 IfType 仍然接受，但只是兼容入口；它们与
// match mltt 共享同一套 MLTT 精确匹配核心。新代码应优先使用 match mltt。
export type LegacyEquivalent: Type0 =
  TypeMatch<Array<string>, Case<Array<infer T>, T>, Default<never>>;
export type CanonicalEquivalent: Type0 =
  match mltt Array<string> { Array<infer T>: T, _: never };
