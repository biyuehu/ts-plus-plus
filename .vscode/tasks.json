{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tsc: watch ./src",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/node_modules/typescript/lib/tsc.js", "--build", "${workspaceFolder}/packages/compiler/src", "--watch"],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [
        "$tsc-watch"
      ]
    },
    {
      "label": "pnpm: build:compiler",
      "type": "shell",
      "command": "pnpm",
      "args": ["build:compiler"],
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "pnpm: build:editor",
      "type": "shell",
      "command": "pnpm",
      "args": ["build:editor"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "pnpm: playground:debug",
      "type": "shell",
      "command": "pnpm",
      "args": ["playground:debug"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:\\s+http://localhost:5173/"
        }
      }
    },
    {
      "label": "pnpm: build:tests",
      "type": "shell",
      "command": "pnpm",
      "args": ["build:tests:notypecheck"],
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    }
  ]
}
